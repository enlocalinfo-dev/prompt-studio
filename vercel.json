{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm sync-templates && node scripts/copy-snapshots-for-api.mjs && node scripts/emit-templates-bundled.mjs && pnpm --filter @prompt-studio/core build && pnpm --filter @prompt-studio/web exec vite build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/health", "destination": "/api?__path=health" },
    { "source": "/api/fetch-url", "destination": "/api?__path=fetch-url" },
    { "source": "/api/generate", "destination": "/api?__path=generate" },
    { "source": "/api/templates/:formatId", "destination": "/api?__path=templates/:formatId" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "packages/core/dist/serverless.cjs,api/lib/**"
    }
  }
}
