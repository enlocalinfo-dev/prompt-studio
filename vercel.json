{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm sync-templates && pnpm --filter @prompt-studio/core build && pnpm --filter @prompt-studio/web exec vite build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/fetch-url", "destination": "/api/fetch-url" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/templates/:formatId", "destination": "/api/templates/:formatId" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/fetch-url.ts": {
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    },
    "api/generate.ts": {
      "maxDuration": 60,
      "includeFiles": "packages/core/dist/**,packages/templates/snapshots/**,api/lib/**"
    },
    "api/templates/[formatId].ts": {
      "includeFiles": "packages/templates/snapshots/**,api/lib/**"
    }
  }
}
