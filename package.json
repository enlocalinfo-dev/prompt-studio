{
  "name": "prompt-studio",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"pnpm --filter @prompt-studio/web dev\" \"pnpm --filter @prompt-studio/server dev\"",
    "dev:web": "pnpm --filter @prompt-studio/web dev",
    "dev:server": "pnpm --filter @prompt-studio/server dev",
    "build": "pnpm sync-templates && pnpm --filter @prompt-studio/core build && pnpm --filter @prompt-studio/web build",
    "sync-templates": "node scripts/sync-templates.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prompt-studio/core": "workspace:*",
    "@vercel/node": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
